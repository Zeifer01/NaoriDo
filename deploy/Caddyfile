# ─────────────────────────────────────────────────────────────────────────────
#  Automatizappy — Caddyfile de produção
# ─────────────────────────────────────────────────────────────────────────────
#  Plataforma:  api.automatizappy.com + *.automatizappy.com (web)
#  Migração:    naorido.com.br / api.naorido.com.br (Naori Do custom + legado)
#  Custom TLS:  On-Demand via ask → /api/public/domain-verify-ask
#
#  Pré-requisitos:
#    1. DNS A/AAAA (e wildcard *.automatizappy.com) apontando para a VPS
#       (Cloudflare: DNS only / nuvem CINZA na 1ª emissão; depois pode proxy)
#    2. Portas 80 e 443 abertas
#    3. Containers: web :3100 (ou :3000), api :3001
#
#  Instalar:
#       sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#       sudo systemctl reload caddy
# ─────────────────────────────────────────────────────────────────────────────

{
	email ivanseifert02@gmail.com

	# On-Demand TLS for customer custom domains (verified in organization_domains)
	on_demand_tls {
		ask http://127.0.0.1:3001/api/public/domain-verify-ask
	}
}

# ─── Platform API ───────────────────────────────────────────────────────────
api.automatizappy.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@websockets {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @websockets 127.0.0.1:3001

	reverse_proxy 127.0.0.1:3001 {
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/automatizappy-api.log {
			roll_size 50mb
			roll_keep 5
		}
		format console
	}
}

# ─── Platform web (apex + app; tenant subdomains via On-Demand below) ───────
# NOTE: do NOT put `*.automatizappy.com` here — wildcard certs require DNS-01.
# Individual tenant hosts (e.g. acai-house.automatizappy.com) are covered by
# the On-Demand TLS block + /api/public/domain-verify-ask.
automatizappy.com, www.automatizappy.com, app.automatizappy.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@websockets {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @websockets 127.0.0.1:3100

	reverse_proxy 127.0.0.1:3100 {
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/automatizappy-web.log {
			roll_size 50mb
			roll_keep 5
		}
		format console
	}
}

# ─── Custom domains (On-Demand TLS) ─────────────────────────────────────────
# Any hostname that passes domain-verify-ask (verified org domain).
# Includes naorido.com.br after seed; keep explicit blocks below during migration.
https:// {
	tls {
		on_demand
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@websockets {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @websockets 127.0.0.1:3100

	reverse_proxy 127.0.0.1:3100 {
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
		header_up X-Real-IP {remote_host}
	}
}

